{
  "data": [
		{
			"name": "TOKEN",
			"type": "jsonpath",
			"string": "${RESPONSEBODY}",
			"path": "$.token",
			"onError": "${errorMessage}"
		},
		{
			"name": "claim",
			"type": "tokenize",
			"string": "${TOKEN}",
			"delimiter": ".",
			"token": "2",
			"onError": "${errorMessage}"
		},		
		{
			"name": "responseBody",
			"type": "base64decode",
			"string": "${CLAIM}",
			"onError": "${errorMessage}"
		}
  ]
}
